{
  "name": "wqrcafe",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/static/*", "!/robots.txt", "!/sitemap.xml"]
  }
}
